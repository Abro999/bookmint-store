# ==========================================================
# Copy this file to .env for LOCAL development only.
# NEVER commit the real .env file.
#
# For the live site, add every one of these in:
# Vercel Dashboard -> your project -> Settings -> Environment
# Variables. None of them need a "VITE_" prefix — that prefix is
# what Vite uses to decide which vars are safe to send to the
# browser, so leaving it off keeps every one of these server-only,
# exactly like they were on Render.
# ==========================================================

# Razorpay (from Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Price to charge, in the smallest unit of the currency —
# cents for USD ($19.00 = 1900), paise for INR (599.00 = 59900).
PRODUCT_PRICE_MINOR_UNITS=1900
PRODUCT_CURRENCY=USD
PRODUCT_NAME=No-Code AI Automation for Small Businesses

# The actual file customers download after paying.
# Place the real file inside private-files/ (project root) and
# put its exact filename here.
PRODUCT_FILE_NAME=No-Code-AI-Automation-for-Small-Businesses.epub

# How long a download link stays valid, and how many times it
# can be used (customers sometimes need to re-download).
DOWNLOAD_LINK_EXPIRY_HOURS=72
DOWNLOAD_MAX_USES=5

# Email delivery (sends the download link after payment).
# Gmail SMTP with an App Password works, or a free provider like
# https://resend.com (100 emails/day free).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Aman Maurya <youremail@gmail.com>"

# Order + download-token storage (replaces the old orders.json file,
# which doesn't work on serverless). Get these for free by adding
# the Upstash Redis integration from the Vercel Dashboard -> your
# project -> Storage tab -> Browse Marketplace -> Upstash -> Redis.
# Vercel fills these in for you automatically once connected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
